    {
      "id": "[REDACTED]",
      "name": "Code — Filter and Prepare Resets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        550,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const errorRows = $('Notion \\u2014 Query Error Rows').all();\nconst staleRows = $('Notion \\u2014 Query Stale Processing').all();\n\nconst now = Date.now();\nconst THREE_HOURS = 3 * 60 * 60 * 1000;\n\nconst retryableErrors = errorRows.filter(row => {\n  const lastError = row.json.properties?.['Last Error']?.rich_text?.[0]?.plain_text || '';\n  const attemptMatch = lastError.match(/^\\[Attempt (\\d+)\\]/);\n  const attempt = attemptMatch ? parseInt(attemptMatch[1]) : 0;\n  return attempt < 3;\n});\n\nconst staleResets = staleRows.filter(row => {\n  const lastEdited = new Date(row.json.last_edited_time).getTime();\n  return (now - lastEdited) > THREE_HOURS;\n});\n\nconst allResets = [...retryableErrors, ...staleResets];\n\nif (allResets.length === 0) {\n  return [];\n}\n\nreturn allResets.map(row => ({ json: row.json }));"
      }
    },
