    {
      "id": "[REDACTED]",
      "name": "Code — Prepare Reset Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1050,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $input.first().json;\nconst lastError = item.properties?.['Last Error']?.rich_text?.[0]?.plain_text || '';\nconst attemptMatch = lastError.match(/^\\[Attempt (\\d+)\\]/);\nconst currentAttempt = attemptMatch ? parseInt(attemptMatch[1]) : 0;\nconst nextAttempt = currentAttempt + 1;\n\nconst cleanError = lastError.replace(/^\\[Attempt \\d+\\]\\s*/, '');\nconst newError = `[Attempt ${nextAttempt}] ${cleanError}`;\n\nreturn [{\n  json: {\n    pageId: item.id,\n    newError: newError.substring(0, 2000)\n  }\n}];"
      }
    },
