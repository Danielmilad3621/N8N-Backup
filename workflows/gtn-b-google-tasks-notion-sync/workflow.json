    {
      "id": "B-plan",
      "name": "Plan Google->Notion Actions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -200,
        300
      ],
      "parameters": {
        "jsCode": "const googleItems = $('Get Google Tasks').all().map(i => i.json);\nconst notionPages = $('Get Notion Pages').all().map(i => i.json);\n\nconst NOW = Date.now();\nconst DAYS_14_MS = 14 * 24 * 60 * 60 * 1000;\nconst TASKLIST_ID = 'MDk4NTUxODgzNzA1NDM2OTIxNjg6MDow';\n\nfunction safeText(v) { return (v == null ? '' : String(v)).trim(); }\nfunction normDate(d) { return d ? String(d).slice(0, 10) : null; }\nfunction statusToNotion(gs) { return gs === 'completed' ? 'Done' : 'Not started'; }\n\nfunction inScope(t) {\n  if (t.status !== 'completed') return true;\n  const updated = t.updated ? new Date(t.updated).getTime() : 0;\n  return updated && (NOW - updated <= DAYS_14_MS);\n}\n\nconst notionByGid = new Map();\nfor (const p of notionPages) {\n  const gid = safeText(p.property_google_task_id || '');\n  if (!gid) continue;\n  const existing = notionByGid.get(gid);\n  if (!existing) {\n    notionByGid.set(gid, p);\n  } else {\n    const a = new Date(existing.last_edited_time || existing.updatedAt || 0).getTime();\n    const b = new Date(p.last_edited_time || p.updatedAt || 0).getTime();\n    if (b >= a) notionByGid.set(gid, p);\n  }\n}\n\nconst out = [];\n\nfor (const g of googleItems) {\n  if (!inScope(g)) continue;\n\n  const gid = safeText(g.id);\n  const matched = notionByGid.get(gid);\n\n  if (!matched) {\n    out.push({ json: {\n      action: 'create_notion',\n      notionPageId: null,\n      googleTaskId: gid,\n      googleTasklistId: g.parent || TASKLIST_ID,\n      title: safeText(g.title) || '(Untitled)',\n      googleStatus: g.status || 'needsAction',\n      notionStatus: statusToNotion(g.status),\n      dueDate: normDate(g.due),\n      notes: safeText(g.notes),\n      webViewLink: g.webViewLink || '',\n    }});\n    continue;\n  }\n\n  const targetTitle = safeText(g.title) || '(Untitled)';\n  const targetStatus = statusToNotion(g.status);\n  const targetDue = normDate(g.due);\n  const targetTasklist = g.parent || TASKLIST_ID;\n  const targetUrl = g.webViewLink || '';\n\n  const currentTitle = safeText(matched.property_task_name || matched.name || '');\n  const currentStatus = safeText(matched.property_status || 'Not started');\n  const currentDue = (() => {\n    const d = matched.property_due_date;\n    if (d && d.start) return normDate(d.start);\n    if (typeof d === 'string' && d) return normDate(d);\n    return null;\n  })();\n  const currentTasklist = safeText(matched.property_google_tasklist_id || '');\n  const currentUrl = safeText(matched.property_google_task_url || '');\n\n  const changed =\n    currentTitle !== targetTitle ||\n    currentStatus !== targetStatus ||\n    currentDue !== targetDue ||\n    currentTasklist !== targetTasklist ||\n    currentUrl !== targetUrl;\n\n  if (changed) {\n    out.push({ json: {\n      action: 'update_notion',\n      notionPageId: matched.id,\n      googleTaskId: gid,\n      googleTasklistId: targetTasklist,\n      title: targetTitle,\n      googleStatus: g.status || 'needsAction',\n      notionStatus: targetStatus,\n      dueDate: targetDue,\n      webViewLink: targetUrl,\n    }});\n  } else {\n    out.push({ json: {\n      action: 'skip_no_change',\n      notionPageId: matched.id,\n      googleTaskId: gid,\n    }});\n  }\n}\n\nreturn out;"
      }
    },
    {
      "id": "B-summary",
      "name": "Summary Google->Notion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        500
      ],
      "parameters": {
        "jsCode": "const allItems = $('Plan Google->Notion Actions').all();\nlet created = 0, updated = 0, skipped = 0;\n\nfor (const item of allItems) {\n  const a = item.json.action;\n  if (a === 'create_notion') created++;\n  else if (a === 'update_notion') updated++;\n  else skipped++;\n}\n\nreturn [{ json: {\n  branch: 'google_to_notion',\n  scanned: allItems.length,\n  created, updated, skipped,\n  timestamp: new Date().toISOString(),\n}}];"
      }
    },
    {
      "id": "B-switch",
      "name": "Route by Action",
