      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        300
      ],
      "parameters": {
        "jsCode": "const bodyData = $json;\nconst sleepNode = $node['Get Sleep'].json;\nconst latestSleep = (sleepNode.data || [])[0] || {};\nconst stages = latestSleep.stages || {};\n\nreturn [{\n  json: {\n    rhr: bodyData.averaged?.resting_heart_rate_bpm || null,\n    hrv: bodyData.averaged?.avg_hrv_sdnn_ms || null,\n    recovery_score: null,\n    deep_sleep_minutes: stages.deep_minutes || null,\n    sleep_debt_minutes: null,\n    sleep_duration_minutes: latestSleep.duration_minutes || null,\n    sleep_efficiency: latestSleep.efficiency_percent || null,\n    rem_minutes: stages.rem_minutes || null,\n    light_minutes: stages.light_minutes || null,\n    sleep_date: latestSleep.date || null,\n  }\n}];\n"
      }
    },
