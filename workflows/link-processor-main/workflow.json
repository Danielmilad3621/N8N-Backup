        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"qwen2.5:1.5b\",\n  \"prompt\": \"You are a summarisation assistant. Summarise the following content in approximately 750 words, structured as 3 clearly labelled sections. Use bullet points within each section. Focus on key points, arguments, and takeaways.\\n\\n---\\n\\n\" + $json.transcript + \"\\n\\n---\\n\\nSummary:\",\n  \"stream\": false,\n  \"options\": {\n    \"num_ctx\": 32768\n  }\n}"
      },
      "id": "[REDACTED]",
      "name": "HTTP — Ollama Summarise (YouTube)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        3360,
        208
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst ollamaResponse = item.response || '';\nconst transcript = item.transcript || '';\n\nfunction chunkText(text, maxLen = 2000) {\n  const chunks = [];\n  let remaining = text;\n  while (remaining.length > 0) {\n    if (remaining.length <= maxLen) {\n      chunks.push(remaining);\n      break;\n    }\n    let splitAt = remaining.lastIndexOf('. ', maxLen);\n    if (splitAt === -1 || splitAt < maxLen * 0.5) splitAt = maxLen;\n    else splitAt += 2;\n    chunks.push(remaining.substring(0, splitAt));\n    remaining = remaining.substring(splitAt);\n  }\n  return chunks;\n}\n\nconst summarySegments = chunkText(ollamaResponse, 2000);\nconst transcriptChunks = chunkText(transcript, 2000);\n\nconst headingBlock = {\n  object: 'block',\n  type: 'heading_2',\n  heading_2: {\n    rich_text: [{ type: 'text', text: { content: 'Transcript' } }]\n  }\n};\n\nconst paragraphBlocks = transcriptChunks.map(chunk => ({\n  object: 'block',\n  type: 'paragraph',\n  paragraph: {\n    rich_text: [{ type: 'text', text: { content: chunk } }]\n  }\n}));\n\nconst allBlocks = [headingBlock, ...paragraphBlocks];\nconst blockBatches = [];\nfor (let i = 0; i < allBlocks.length; i += 100) {\n  blockBatches.push(allBlocks.slice(i, i + 100));\n}\n\nreturn [{\n  json: {\n    ...item,\n    summarySegments,\n    blockBatches,\n    contentType: 'YouTube'\n  }\n}];"
      },
