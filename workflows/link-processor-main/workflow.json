    {
      "parameters": {
        "jsCode": "const pollResponse = $input.first().json;\nconst poll = pollResponse._poll;\nconst status = pollResponse.status;\nconst attempt = (poll?.attempt || 0) + 1;\n\nif (status === 'completed') {\n  return [{\n    json: {\n      ...pollResponse,\n      _pollResult: 'completed',\n      transcript: pollResponse.result?.text || '',\n      language: pollResponse.result?.language || 'en'\n    }\n  }];\n}\n\nif (status === 'failed') {\n  return [{\n    json: {\n      ...pollResponse,\n      _pollResult: 'failed',\n      error: pollResponse.failedReason || 'Whisper job failed'\n    }\n  }];\n}\n\nif (attempt >= (poll?.maxPolls || 240)) {\n  return [{\n    json: {\n      ...pollResponse,\n      _pollResult: 'timeout',\n      error: `Whisper polling timed out after ${attempt} attempts`\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...pollResponse,\n    _poll: {\n      ...poll,\n      attempt\n    },\n    _pollResult: 'pending'\n  }\n}];"
      },
