      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst jobId = item.jobId;\nconst estimatedWait = item.estimatedWait || 600;\nconst maxPolls = Math.ceil(Math.max(estimatedWait * 2, 7200) / 30);\n\nif (!jobId) {\n  return [{\n    json: {\n      ...item,\n      _pollResult: 'failed',\n      error: item.message || item.error || 'Whisper submit failed - no jobId returned'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...item,\n    _poll: {\n      jobId,\n      attempt: 0,\n      maxPolls,\n      estimatedWait\n    }\n  }\n}];"
      },
