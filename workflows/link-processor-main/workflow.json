    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.notion.com/v1/pages/{{ $json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "[REDACTED]",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"properties\": {\n    \"Processing State\": { \"select\": { \"name\": \"Done\" } },\n    \"Processed\": { \"checkbox\": true },\n    \"Processed At\": { \"date\": { \"start\": \"{{ $now.toISO() }}\" } },\n    \"Content Type\": { \"select\": { \"name\": \"{{ $json.contentType }}\" } },\n    \"AI Summary\": {\n      \"rich_text\": {{ JSON.stringify($json.summarySegments.map(s => ({ type: 'text', text: { content: s } }))) }}\n    },\n    \"Last Error\": {\n      \"rich_text\": [{ \"type\": \"text\", \"text\": { \"content\": \"\" } }]\n    }\n  }\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "[REDACTED]",
      "name": "HTTP — Notion Write Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        3904,
        352
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst pageId = item.id;\nconst blockBatches = item.blockBatches || [];\n\nif (blockBatches.length === 0) {\n  return [{ json: { ...item, transcriptAppended: false } }];\n}\n\ntry {\n  const childrenResponse = await this.helpers.httpRequestWithAuthentication.call(this, 'notionApi', {\n    method: 'GET',\n    url: `https://api.notion.com/v1/blocks/${pageId}/children?page_size=100`,\n    headers: { 'Notion-Version': '2022-06-28' }\n  });\n\n  const hasTranscriptHeading = childrenResponse.results?.some(\n    block => block.type === 'heading_2' &&\n             block.heading_2?.rich_text?.[0]?.plain_text === 'Transcript'\n  );\n\n  if (hasTranscriptHeading) {\n    return [{ json: { ...item, transcriptAppended: false, skipped: true } }];\n  }\n\n  for (const batch of blockBatches) {\n    await this.helpers.httpRequestWithAuthentication.call(this, 'notionApi', {\n      method: 'PATCH',\n      url: `https://api.notion.com/v1/blocks/${pageId}/children`,\n      headers: {\n        'Notion-Version': '2022-06-28',\n        'Content-Type': 'application/json'\n      },\n      body: { children: batch }\n    });\n    await new Promise(resolve => setTimeout(resolve, 350));\n  }\n\n  return [{ json: { ...item, transcriptAppended: true } }];\n} catch (e) {\n  return [{ json: { ...item, transcriptAppended: false, error: e.message } }];\n}"
      },
