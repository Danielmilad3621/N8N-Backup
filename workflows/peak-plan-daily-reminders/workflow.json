    {
      "id": "build-tasks",
      "name": "Build Today Tasks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        400
      ],
      "parameters": {
        "jsCode": "const PLAN_START = new Date('2026-04-14');\nconst now = new Date();\nconst dayIndex = Math.floor((now - PLAN_START) / (1000 * 60 * 60 * 24));\n\nif (dayIndex < 0 || dayIndex > 17) {\n  return [{ json: { skip: true, reason: 'Outside plan dates' } }];\n}\n\nconst phases = [\n  { name: 'Phase 1: Hard Reset', days: 7 },\n  { name: 'Phase 2: Build & Optimize', days: 7 },\n  { name: 'Phase 3: Peak', days: 4 },\n];\n\nlet phaseIdx = 0, dayInPhase = dayIndex;\nfor (const p of phases) {\n  if (dayInPhase < p.days) break;\n  dayInPhase -= p.days;\n  phaseIdx++;\n}\n\nreturn [{\n  json: {\n    skip: false,\n    dayIndex,\n    dayLabel: `Day ${dayIndex + 1}`,\n    phaseIdx,\n    dayInPhase,\n    timeLabel: 'Daily',\n  }\n}];\n"
      }
    },
